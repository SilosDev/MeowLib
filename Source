			local function SelectCurrentTab()
				local easetime = 0.2

				if currentTabInstance then
					local outTween = Tween(currentTabInstance:FindFirstChild("Elements"), TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
						BackgroundTransparency = 1
					})
					outTween:Play()
					outTween.Completed:Wait()
					currentTabInstance.Parent = nil
				end

				for i, tabInfo in pairs(tabs) do
					Tween(i, AnimationPresets.Smooth, {
						BackgroundTransparency = (i == tabSwitcher and 0.5 or 1)
					}):Play()

					if tabInfo.tabStroke then
						Tween(tabInfo.tabStroke, AnimationPresets.Smooth, {
							Transparency = (i == tabSwitcher and 0.85 or 1)
						}):Play()
					end
					if tabInfo.switcherImage then
						Tween(tabInfo.switcherImage, AnimationPresets.Smooth, {
							ImageTransparency = (i == tabSwitcher and 0.1 or 0.5)
						}):Play()
					end
					if tabInfo.switcherName then
						Tween(tabInfo.switcherName, AnimationPresets.Smooth, {
							TextTransparency = (i == tabSwitcher and 0 or 0.4)
						}):Play()
					end
				end

